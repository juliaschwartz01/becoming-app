# Copy this file to ".env.local" (which is never committed) and fill in your Supabase values.
# Both values are safe to be public: access to your data is protected by Supabase Row Level Security.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Leave this as "false" until a real AI provider has been approved and connected (see CLAUDE.md).
VITE_AI_ENABLED=false
